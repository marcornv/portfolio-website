---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import About from "../components/About.astro";
import { site } from "../site.config";
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="wrap">
      <h1 id="hero-heading">
        {site.headline.map((line) => <span>{line}</span>)}
      </h1>
      <p class="intro">{site.intro}</p>
      <p class="links">
        <a href={site.links.github}>GitHub</a>
        <a href={site.links.linkedin}>LinkedIn</a>
      </p>
    </div>
  </section>

  <ProjectGrid />
  <About />
</BaseLayout>

<style>
  /* A page from a dot-grid notebook, only behind the hero. */
  .hero {
    padding-block: var(--space-5) var(--space-5);
    border-bottom: 1px solid var(--rule);
    background-image: radial-gradient(var(--rule) 1.2px, transparent 1.4px);
    background-size: 22px 22px;
    background-position: -11px -11px;
  }
  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-6);
    }
  }
  h1 {
    font-size: var(--step-hero);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    color: var(--graphite);
  }
  .intro {
    max-width: 52ch;
    margin-top: var(--space-3);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .links {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font-weight: 600;
  }
</style>
