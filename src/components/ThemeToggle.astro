<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false">
  <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
  </svg>
  <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
    </g>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const root = document.documentElement;

  function sync() {
    button?.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
  }

  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .theme-toggle:hover {
    border-color: var(--ink);
  }
  /* Show the moon in light mode (switch to dark), the sun in dark mode. */
  .sun {
    display: none;
  }
  :global([data-theme="dark"]) .sun {
    display: block;
  }
  :global([data-theme="dark"]) .moon {
    display: none;
  }
</style>
