---
import { getEntry, render } from "astro:content";
import SkillList from "./SkillList.astro";
import { site } from "../site.config";

const about = await getEntry("about", "about");
if (!about) throw new Error("Missing src/content/about/about.md");
const { Content } = await render(about);
---

<section id="about" class="wrap section" aria-labelledby="about-heading">
  <h2 id="about-heading">About</h2>
  <div class="columns">
    <div class="bio">
      <Content />
      <p class="contact">
        Find me on <a href={site.links.linkedin}>LinkedIn</a> or <a href={site.links.github}>GitHub</a>.
      </p>
    </div>
    <aside aria-label="Skills">
      {about.data.location && <p class="location">Based in {about.data.location}</p>}
      <SkillList skills={about.data.skills} />
    </aside>
  </div>
</section>

<style>
  .section {
    padding-top: var(--space-6);
    scroll-margin-top: var(--space-2);
  }
  h2 {
    margin-bottom: var(--space-3);
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }
  .columns {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 52rem) {
    .columns {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-5);
    }
  }
  .bio {
    max-width: var(--measure);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    line-height: 1.65;
  }
  .bio :global(p + p),
  .contact {
    margin-top: 1em;
  }
  aside {
    padding-top: var(--space-1);
  }
  @media (min-width: 52rem) {
    aside {
      padding-left: var(--space-4);
      border-left: 1px solid var(--rule);
    }
  }
  .location {
    margin-bottom: var(--space-3);
    color: var(--graphite);
  }
</style>
