---
interface Props {
  skills: { group: string; items: string[] }[];
}

const { skills } = Astro.props;
---

<dl class="skills">
  {
    skills.map(({ group, items }) => (
      <div>
        <dt>{group}</dt>
        <dd>
          <ul>
            {items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  dt {
    margin-bottom: var(--space-1);
    font-weight: 700;
  }
  dd {
    margin: 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 0;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--graphite);
  }
  li:not(:last-child)::after {
    content: ",";
    margin-right: 0.4em;
  }
</style>
